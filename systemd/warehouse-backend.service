[Unit]
Description=Product Warehouse Backend Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/Product_Warehouse/src/Backend

# 环境变量
Environment="PYTHONPATH=/root/Product_Warehouse/src/Backend"
# 使用 .env（测试数据库 warehouse_test_data）
# 生产环境请改为: EnvironmentFile=/root/Product_Warehouse/.env.production
EnvironmentFile=/root/Product_Warehouse/.env

# 启动命令
ExecStart=/root/Product_Warehouse/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 4 \
    --log-level info

# 重启策略
Restart=always
RestartSec=5
StartLimitInterval=0

# 资源限制
LimitNOFILE=65536

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=warehouse-backend

[Install]
WantedBy=multi-user.target

