# ==========================================
# Product Warehouse - 生产环境配置模板
# ==========================================
# 部署时复制为 .env 并填入实际值
# cp .env.production.example .env && nano .env

# -----------------
# 前端配置
# -----------------
VITE_API_URL=/api/v1
VITE_WS_URL=wss://api.rexp.top/ws
VITE_BASE_URL=/
VITE_NODE_ENV=production
VITE_BYPASS_AUTH=false

# -----------------
# 后端配置（Python）
# -----------------
# 阿里云 RDS MySQL 数据库
# 格式: mysql+pymysql://用户名:密码@RDS地址:3306/数据库名
DATABASE_URL=mysql+pymysql://username:password@rm-xxxxx.mysql.rds.aliyuncs.com:3306/warehouse_test_data

# 密钥配置（⚠️ 必须生成强密钥！）
# 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 配置（包含 Vercel 域名）
BACKEND_CORS_ORIGINS=["https://api.rexp.top", "https://www.rexp.top", "https://rexp.top", "https://your-project.vercel.app"]

# 服务器配置
HOST=127.0.0.1
PORT=8001

# 日志级别
DEBUG=False
LOG_LEVEL=INFO

# -----------------
# 高德地图 API 配置
# -----------------
AMAP_KEY=your-amap-server-key
VITE_AMAP_KEY=your-amap-web-key

# -----------------
# Dify Cloud 配置
# -----------------
# 使用 Dify Cloud: https://cloud.dify.ai
# 1. 注册/登录 Dify Cloud
# 2. 创建应用并获取 API Key
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=app-your-dify-cloud-api-key

# -----------------
# 其他配置
# -----------------
TZ=Asia/Shanghai
